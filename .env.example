# Google Gemini API Key for AI Electoral Roll Scanning & OCR
GEMINI_API_KEY=your_gemini_api_key_here

# Server & Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL 14+)
# Example: postgresql://postgres:postgres@localhost:5432/voter_finder?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voter_finder?schema=public
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL=false

# In-Memory / SQLite Fallback Mode (For local standalone testing if PostgreSQL is absent)
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/voter_finder.db

# Storage Layer Configuration (Local or S3 compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage_uploads
# S3 Configuration (when STORAGE_PROVIDER=s3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=election-voter-rolls

# OCR Engine Configuration
OCR_PROVIDER=standard
OCR_CONFIDENCE_THRESHOLD=0.75
OCR_MAX_CONCURRENT_PAGES=4
# Path to Tesseract binary (if using tesseract provider)
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=hin+eng

# Search & Transliteration Tuning
SEARCH_TRIGRAM_THRESHOLD=0.25
SEARCH_MAX_RESULTS_LIMIT=100
ENABLE_SEARCH_LOGGING=true

# Security & Rate Limiting
RATE_LIMIT_MAX_PER_MINUTE=60
ADMIN_API_KEY=voterfinder_super_secret_admin_key_change_in_production
JWT_SECRET=super_secret_jwt_key_for_voter_finder_auth_change_in_prod
